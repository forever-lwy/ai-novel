# 本地开发默认只监听本机。Docker Compose 会设置 HOST=0.0.0.0。
HOST=127.0.0.1
PORT=4317
DATA_DIR=./data
# 新数据目录首次启动必填：取消注释，填写至少 12 位有效字符的非弱密码。
# 已有数据库密码不会被此项覆盖；初始化成功后可移除，改密使用账号安全页。
# Docker Compose 中值含 $ 时用单引号包围，避免变量插值。
# INITIAL_PASSWORD=
# 原生生产运行启用；Docker 已设置 production。
# NODE_ENV=production
# 公网来源只接受 HTTPS 的来源，不要带子路径、查询参数或凭据。
# PUBLIC_ORIGIN=https://novel.example.com
# 配置 PUBLIC_ORIGIN 后自动启用安全 Cookie，留空即可，不能设为 false。
# COOKIE_SECURE=true
# 只填写服务实际收到连接的代理 IP/CIDR，逗号分隔；默认不信任转发头。
# TRUSTED_PROXIES=
# 生产模式默认只允许 HTTPS 公网模型地址。
# 设置后只允许列出的全部模型来源（协议、主机和端口，不带路径）。
# 自建 HTTP/私网网关也必须明确列入，多个来源以逗号分隔。
# OUTBOUND_ALLOWED_ORIGINS=
# Compose 专用：默认只绑定本机端口；建议继续由 HTTPS 反向代理提供公网访问。
# BIND_ADDRESS=127.0.0.1
# MEMORY_LIMIT=2g
